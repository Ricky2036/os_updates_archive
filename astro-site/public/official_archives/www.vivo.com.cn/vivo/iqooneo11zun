.6277 17.1038Z\" stroke=\"white\" stroke-width=\"2.3\" /> \n         \u003Cpath d=\"M12.8085 21.0412C17.3557 21.0412 21.042 17.355 21.042 12.8077C21.042 8.26049 17.3557 4.57422 12.8085 4.57422C8.26122 4.57422 4.57495 8.26049 4.57495 12.8077C4.57495 17.355 8.26122 21.0412 12.8085 21.0412Z\" stroke=\"white\" stroke-width=\"1.15\" /> \n        \u003C/g> \n        \u003Cdefs> \n         \u003Cclippath id=\"clip0_2673_851\"> \n          \u003Crect width=\"25\" height=\"26\" fill=\"white\" /> \n         \u003C/clippath> \n        \u003C/defs> \n       \u003C/svg> \n       \u003Cspan uimix-text=\"iqooneo11supreme-live-3\">动态照片\u003C/span> \n      \u003C/div> \n      \u003Cdiv class=\"umx-video-box umx-video-box1\"> \n       \u003Cdiv class=\"umx-live-video umx-live-video-video1\">\u003C/div> \n       \u003Cimg class=\"umx-live-video-img umx-live-video-img1\" src alt> \n      \u003C/div> \n     \u003C/div> \n    \u003C/div> \n    \u003Cdiv class=\"umx-stage iqooneo11supreme-watercolour\"> \n     \u003Cdiv class=\"umx-section\" data-track=\"{'type':'viewstate','params':{'cfrom':'00003','pagecode':'003','product':'iQOO Neo11 至尊版','block':'38','total':'42'}}\"> \n      \u003Cdiv class=\"umx-title umx-data-speed\"> \n       \u003Cp uimix-text=\"iqooneo11supreme-watercolour-1\" class=\"umx-main-title umx-56\">签到水印\u003C/p> \n       \u003Cp uimix-text=\"iqooneo11supreme-watercolour-2\" class=\"umx-intro\">日常记录、签到打卡、位置显示，还可自定义文本，拍照打卡更省心。\u003C/p> \n      \u003C/div> \n     \u003C/div> \n     \u003Cdiv class=\"umx-figure-box umx-data-speed-wap\"> \n      \u003Cfigure class=\"umx-f1 lazy-imageom\">\u003C/figure> \n     \u003C/div> \n    \u003C/div> \n    \u003Cdiv class=\"umx-stage iqooneo11supreme-os\"> \n     \u003Cdiv class=\"umx-section umx-section1\" data-track=\"{'type':'viewstate','params':{'cfrom':'00003','pagecode':'003','product':'iQOO Neo11 至尊版','block':'39','total':'42'}}\"> \n      \u003Cdiv class=\"umx-title umx-data-speed\"> \n       \u003Cfigure class=\"umx-f1 lazy-imageom\">\u003C/figure> \n       \u003Cp uimix-text=\"iqooneo11supreme-os-1\" class=\"umx-intro\">依托自研蓝河流畅引擎，通过抗老化模型升级和以真实物理体验为基础的原子动效 6.0，\u003Cbr class=\"umx-mb-hide\">打造出集生态破壁、智慧流畅与场景化体验于一体的系统，5 年使用也持久流畅\u003Csup>21\u003C/sup>。\u003C/p> \n      \u003C/div> \n     \u003C/div> \n     \u003Cdiv class=\"umx-section umx-section2\" data-track=\"{'type':'viewstate','params':{'cfrom':'00003','pagecode':'003','product':'iQOO Neo11 至尊版','block':'40','total':'42'}}\"> \n      \u003Cdiv class=\"umx-title umx-data-speed\"> \n       \u003Cul class=\"umx-data-items umx-data-speed-wap\"> \n        \u003Cli class=\"umx-li1\"> \n         \u003Cfigure class=\"umx-icon2 lazy-imageom\">\u003C/figure> \n         \u003Cdiv class=\"umx-txt\"> \n          \u003Cstrong class=\"umx-36\" uimix-text=\"iqooneo11supreme-os-4\">小V 修图\u003C/strong> \n          \u003Cp uimix-text=\"iqooneo11supreme-os-5\">相册中一键唤起小V，一句话生成图片，\u003Cbr class=\"umx-mb-hide\">支持多轮对话修图，轻松修出好效果。\u003C/p> \n         \u003C/div> \u003C/li> \n        \u003Cli class=\"umx-li2\"> \n         \u003Cfigure class=\"umx-icon1 lazy-imageom\">\u003C/figure> \n         \u003Cdiv class=\"umx-txt\"> \n          \u003Cstrong class=\"umx-36\" uimix-text=\"iqooneo11supreme-os-6\">小V 圈搜 2.0\u003C/strong> \n          \u003Cp uimix-text=\"iqooneo11supreme-os-7\">长按识屏，自动识别屏幕关键信息，操作简单，\u003Cbr class=\"umx-mb-hide\">快人不止一步。\u003C/p> \n         \u003C/div> \u003C/li> \n        \u003Cli class=\"umx-li3\"> \n         \u003Cfigure class=\"umx-icon4 lazy-imageom\">\u003C/figure> \n         \u003Cdiv class=\"umx-txt\"> \n          \u003Cstrong class=\"umx-36\" uimix-text=\"iqooneo11supreme-os-8\">小V 记忆 2.0*\u003C/strong> \n          \u003Cp uimix-text=\"iqooneo11supreme-os-9\">新增「识屏记」，多场景一键识屏快速加入收藏，\u003Cbr class=\"umx-mb-hide\">侧边栏直达，随手收藏更便捷，助你化身攻略大师。\u003C/p> \n         \u003C/div> \u003C/li> \n        \u003Cli class=\"umx-li4\"> \n         \u003Cfigure class=\"umx-icon3 lazy-imageom\">\u003C/figure> \n         \u003Cdiv class=\"umx-txt\"> \n          \u003Cstrong class=\"umx-36\" uimix-text=\"iqooneo11supreme-os-10\">全新蓝心小V\u003C/strong> \n          \u003Cp uimix-text=\"iqooneo11supreme-os-11\">新增「深度研究」，任务再复杂，一句话就搞定，\u003Cbr class=\"umx-mb-hide\">同时支持深度联网分析，轻松输出专业研究报告。\u003C/p> \n         \u003C/div> \u003C/li> \n       \u003C/ul> \n       \u003Cp class=\"umx-p-tips\" uimix-text=\"iqooneo11supreme-os-12\">*部分页面下，侧边栏默认不展示「识屏记」。可在打开侧边栏后，点击侧边栏下方的“ \u003Cspan class=\"umx-sp\">&gt;\u003C/span> ”，点击“编辑应用”，将「识屏记」添加为常驻工具。\u003C/p> \n      \u003C/div> \n     \u003C/div> \n     \u003Cdiv class=\"umx-button-box umx-data-speed-wap\"> \n      \u003Cp uimix-text=\"iqooneo11supreme-os-13\" class=\"umx-intro\">详尽与更全面的 OriginOS 6，\u003Cbr class=\"umx-mb-show\">请前往 vivo OriginOS 官网了解。\u003C/p> \n      \u003Cdiv class=\"button-box\"> \n       \u003Cdiv class=\"button\"> \n        \u003Ca href=\"https://www.vivo.com/originos\" target=\"_blank\" data-track=\"{'type':'viewstate','params':{'cfrom':'00003','pagecode':'003','product':'iQOO Neo11 至尊版','block':'40-1','total':'42'}}\"> \u003Cspan uimix-text=\"iqooneo11supreme-os-14\">进一步了解 &gt;&gt;\u003C/span> \u003C/a> \n       \u003C/div> \n      \u003C/div> \n     \u003C/div> \n    \u003C/div> \n    \u003Cdiv class=\"umx-stage iqooneo11supreme-packlist\" data-track=\"{'type':'viewstate','params':{'cfrom':'00003','pagecode':'003','product':'iQOO Neo11 至尊版','block':'41','total':'42'}}\"> \n     \u003Cdiv class=\"umx-section umx-data-speed-wap\"> \n      \u003Cdiv class=\"umx-title\"> \n       \u003Cp uimix-text=\"iqooneo11supreme-packlist-1\" class=\"umx-main-title\">包装清单\u003C/p> \n       \u003Cp uimix-text=\"iqooneo11supreme-packlist-2\" class=\"umx-intro\">手机 × 1、充电器 × 1、数据线 × 1、快速入门指南 × 1、取卡针 × 1、手机保护壳 × 1\u003C/p> \n      \u003C/div> \n     \u003C/div> \n     \u003Cdiv class=\"umx-figure-box umx-current umx-data-speed-wap\"> \n      \u003Cfigure class=\"umx-f6 lazy-imageom\">\u003C/figure> \n      \u003Cfigure class=\"umx-f5 lazy-imageom\">\u003C/figure> \n      \u003Cfigure class=\"umx-f4 lazy-imageom\">\u003C/figure> \n      \u003Cfigure class=\"umx-f3 lazy-imageom\">\u003C/figure> \n      \u003Cfigure class=\"umx-f2 lazy-imageom\">\u003C/figure> \n      \u003Cfigure class=\"umx-f1 lazy-imageom\">\u003C/figure> \n     \u003C/div> \n     \u003Cp class=\"umx-p-tips\" uimix-text=\"iqooneo11supreme-packlist-3\">*手机出厂时已贴好原装屏幕保护膜；手机及保护壳颜色以您实际购买的版本为准；包装内不含耳机；产品、配件批次不同，细节可能略有差异，以上包装清单仅为参考，\u003Cbr class=\"umx-md-show\">具体请以实物为准。\u003C/p> \n    \u003C/div> \n   \u003C/div> \n   \u003Cdiv class=\"umx-stage umx-stage-tips\"> \n    \u003Cdiv class=\"umx-tip-content\" data-track=\"{'type':'viewstate','params':{'cfrom':'00003','pagecode':'003','product':'iQOO Neo11 至尊版','block':'42','total':'42'}}\"> \n     \u003Ch4 uimix-text=\"iqooneo11supreme-tips-1\">备注：\u003C/h4> \n     \u003Cul class=\"umx-case\"> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-2\">数据源自 vivo 实验室，系对比 iQOO Neo11 的屏幕功耗数据，实际情况会因测试环境、测试条件等不同略有差异，请以实际使用为准。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-3\">数据源自 vivo 实验室，实际情况会因测试环境、测试条件等不同略有差异。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-4\">数据源自 MediaTek 官网，对比对象为天玑 9400。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-5\">数据源自 vivo 实验室，系对比 iQOO Neo11 的提升数据。实际情况会因测试环境、测试条件等不同略有差异，请以实际使用为准。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-6\">数据源自 vivo 实验室，连接 5.8G 频段 Wi-Fi 在空旷、无遮挡、无干扰场景的测试数据，实际通信距离受环境因素影响，请以实际体验为准。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-7\">数据源自 vivo 实验室，连接 5.8G 频段 Wi-Fi 测试所得，Wi-Fi 穿墙层数和体验受环境因素影响，请以实际体验为准。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-8\">数据源自 vivo 实验室，在真实校园场景连接 Wi-Fi 和蜂窝测试所得，为对比不开启功能数据，部分校园 Wi-Fi 无法加速，请以实际体验为准，或咨询官方客服是否支持。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-9\">数据源自 vivo 实验室，系开启超感触控测得的数据，实际情况会因测试环境、测试条件等不同略有差异，请以实际使用为准。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-10\">数据源自 vivo 实验室，系对比使用高精度陀螺仪校准仪校准前的数据。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-11\">本产品采用单电芯设计：典型容量：9100mAh（3.74V），典型能量：34.04Wh；额定容量：8905mAh（3.74V），额定能量：33.31Wh。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-12\">数据源自 vivo 实验室，实际情况会因测试环境、测试软件等不同而略有差异。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-13\">数据源自 vivo 实验室，在《MOBA 手游》60 帧 + 极致模式中测得，实际情况因测试环境、测试软件等不同而略有差异。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-14\">大学生日常续航模型，共 9 小时亮屏时间，包含玩 MOBA 手游 3 小时，聊天 1 小时，刷短视频 2 小时、看视频 1 小时，读小说 1 小时，听歌 1 小时。数据源自 vivo 实验室，实际情况会因测试环境、测试条件等不同略有差异，请以实际使用为准。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-15\">数据源自 vivo 实验室，系对比 iQOO Neo11 的提升数据。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-16\">数据源自 vivo 实验室的极限散热模拟实验，指 CPU 热源 10 秒骤降 15℃，实际情况会因测试环境、测试条件等不同略有差异。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-17\">数据源自 vivo 实验室，为 VC 单体数据。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-18\">数据源自 vivo 实验室，系对比关闭超感音域的数据。实际情况会因测试环境、测试条件等不同略有差异，请以实际使用为准。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-19\">该机型并非专业防水手机，在正常使用状态下可防溅、抗水、防尘。在受控实验室条件下，经测试，在 GB/T 4208-2017（国内）标准下达到 IP69 、IP68 级别。其中 IP68 级抗水测试条件为：①无流动清水，水深 1.5 米；②试验时间 30 分钟；③水温与产品温差不大于 5 摄氏度。其中 IP69 级抗水测试条件为：①转盘转速：（5±1）r/min；②喷嘴角度：0°、30°、60°、90°；③流量：（15±1）L/min；④水温：（80±5）℃；⑤试验时间：30s / 位置；⑥手机放置方式：竖直放置，USB 口朝下。抗热水、抗喷水、抗浸水、防尘功能并非永久有效，防护性能可能会因日常磨损而下降。请勿在潮湿状态下为手机充电；请参阅手机内置使用说明了解清洁和干燥说明。由于浸入液体而导致的损坏不在保修范围之内。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-20\">普通第三方钢化膜可能影响超声波指纹识别，本产品推荐使用原装保护膜或超声波专用钢化膜，超声波专用钢化膜可在 vivo 官方商城购买，手机包装内不含，请单独购买。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-21\">手机通过军标抗冲击测试 GJB150.18A，军标 GJB150《军用装备实验室环境试验方法》分为 28 个部分，GJB150.18A 是冲击试验章节标准。GJB150.18A 规定了军用装备在实验室环境下进行冲击试验的具体要求和方法，如通信设备、电子仪器、车辆、航空航天器部件等，旨在评估装备在经受冲击后的结构和功能完整性，以确保这些装备在恶劣环境下仍能正常运作。军标无官方命名及标识，仅委托实验室以军用产品标准做部分项次的测试。\u003C/li> \n      \u003Cli uimix-text=\"iqooneo11supreme-tips-22\">数据源自 vivo 实验室，5 年持久流畅非指绝对流畅不卡顿，因机器老化、网络环境、个人使用习惯等因素不同，体验可能有所差异，请以实际体验为准。\u003C/li> \n      \u003Cli class=\"umx-xh umx-xh-mt\" uimix-text=\"iqooneo11supreme-tips-bottom-8\">\u003Cspan>* \u003C/span>iQOO Neo11 至尊版支持蓝牙耳机与 Type-C 接口的数字有线耳机，不支持 Type-C 接口的模拟有线耳机（如 vivo XE 系列 Type-C 接口模拟耳机）。如需使用 Type-C 接口的耳机，需确认耳机为数字耳机（建议您与耳机供应方确认），如您需要购买，建议您可以选择 vivo 官网上架的 Type-C 数字有线耳机（型号为 vivo XE160 Type-C 数字信号有线耳机或兰士顿 Type-C 数字信号入耳式有线耳机）。如需使用 3.5mm 接口的模拟耳机，则需要搭配内置 DAC 数字解码芯片的 Type-C 转接器使用，转接器需单独购买。耳机型号、协议多样，可能存在特殊情况，请以实际体验为准。\u003C/li> \n      \u003Cli class=\"umx-xh umx-xh-mt\" uimix-text=\"iqooneo11supreme-tips-bottom-1\">\u003Cspan>* \u003C/span>以上页面中产品效果（包括但不限于外观、颜色、尺寸、结构图）和屏幕显示内容（包括但不限于背景、UI、配图）为广告创意展示，部分图片由 AI 生成，仅做示意参考，请以实物为准。\u003C/li> \n      \u003Cli class=\"umx-xh umx-xh-mt\" uimix-text=\"iqooneo11supreme-tips-bottom-2\">\u003Cspan>* \u003C/span>数据源自 vivo 实验室，受产品配置和制造工艺、测量方法的影响，实际产品尺寸可能有所差异，请以实物为准。\u003C/li> \n      \u003Cli class=\"umx-xh umx-xh-mt\" uimix-text=\"iqooneo11supreme-tips-bottom-3\">\u003Cspan>* \u003C/span>以上样张效果仅供参考，不同拍摄模式的像素可能存在差异，部分样张大小经过裁剪，仅供参考，请以实际拍摄效果为准。\u003C/li> \n      \u003Cli class=\"umx-xh umx-xh-mt\" uimix-text=\"iqooneo11supreme-tips-bottom-4\">\u003Cspan>* \u003C/span>如无特殊备注说明，以上页面的数据及参数为我司实验室标准环境下的测试结果，实际使用中可能因产品软件版本、设备状况、个体差异、使用习惯和环境因素不同而有所差异，请以实际使用情况为准。\u003C/li> \n      \u003Cli class=\"umx-xh umx-xh-mt\" uimix-text=\"iqooneo11supreme-tips-bottom-5\">\u003Cspan>* \u003C/span>由于产品的某些规格、参数、零部件、外观细节可能因供应商更换或生产批次等原因发生变化，vivo 将根据调整实时更新页面内的描述，请以实际使用情况为准。\u003C/li> \n      \u003Cli class=\"umx-xh umx-xh-mt\" uimix-text=\"iqooneo11supreme-tips-bottom-6\">\u003Cspan>* \u003C/span>由于手机系统和预装的程序占据了部分存储空间，且会随着操作系统或软件版本的更新可能会导致可用空间发生变化，实际运存空间和存储空间略小。\u003C/li> \n      \u003Cli class=\"umx-xh umx-xh-mt\" uimix-text=\"iqooneo11supreme-tips-bottom-7\">\u003Cspan>* \u003C/span>支持未成年人模式，保护未成年人用机网络安全，请前往“设置 - 健康使用设备 - 本设备模式 - 未成年人模式”开启。\u003C/li> \n     \u003C/ul> \n    \u003C/div> \n    \u003Cdiv class=\"umx-tips-box\">\u003C/div> \n   \u003C/div> \n  \u003C/div> \n \u003C/div> \n \u003Cdiv class=\"product-detail-wrapper clear-transform\">\u003C/div> \