    },
    {
      "id": "update-27",
      "module": "网络",
      "moduleSource": "explicit-heading",
      "type": "优化",
      "typeSource": "explicit",
      "sourceText": "网络：优化 校园走动上网体验，系统自动选择当前最优网络，减少上网卡顿。",
      "description": "校园走动上网体验，系统自动选择当前最优网络，减少上网卡顿。",
