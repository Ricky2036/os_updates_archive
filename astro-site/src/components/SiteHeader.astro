---
import Icon from './Icon.astro';
import { brandMeta, sitePath, getArticles, articlePath, type Brand } from '../lib/archive';
import { officialArchiveMeta, type ColorOSSection } from '../lib/official-archives';

interface Props { activeBrand?: Brand; hasArchiveNav?: boolean; hasMonthlyViewToggle?: boolean; activeColorOSSection?: ColorOSSection; activeOriginOSSection?: ColorOSSection; activeHyperOSSection?: string; }
const { activeBrand, hasArchiveNav = false, hasMonthlyViewToggle = false, activeColorOSSection = activeBrand === 'coloros' ? 'monthly' : undefined, activeOriginOSSection = activeBrand === 'originos' ? 'monthly' : undefined, activeHyperOSSection = activeBrand === 'hyperos' ? 'monthly' : undefined } = Astro.props;
const colorOSActive = activeBrand === 'coloros';
const originOSActive = activeBrand === 'originos';
const hyperOSActive = activeBrand === 'hyperos';
const magicOSActive = activeBrand === 'magicos';

const articles = await getArticles();
const getLatestUrl = (brand: Brand) => {
  const latest = articles.find(a => a.data.brand === brand);
  return latest ? articlePath(latest) : sitePath(`${brand}/`);
};
const colorOSLatestUrl = getLatestUrl('coloros');
const originOSLatestUrl = getLatestUrl('originos');
const hyperOSLatestUrl = getLatestUrl('hyperos');
const magicOSLatestUrl = getLatestUrl('magicos');

---
<header class:list={{ 'site-header': true, 'has-archive-nav': hasArchiveNav }}>
  <div class="header-inner">
    <div class="header-left-group" style="display: flex; align-items: center; gap: 16px;">
      <a class="brand-mark" href={sitePath()} aria-label="OS档案馆首页">
        <img src={sitePath('assets/images/archive-mark.svg')} alt="" width="32" height="32" />
        <span>OS档案馆</span>
      </a>
      {hasMonthlyViewToggle && (
        <button type="button" class="header-view-toggle" data-monthly-view-toggle aria-label="切换原始版和精简版" title="切换视图">
          <div class="icon-digest"><Icon name="list" size={18} /></div>
          <div class="icon-original"><Icon name="image" size={18} /></div>
        </button>
      )}
    </div>
    {hasArchiveNav && (
      <button class="menu-button" type="button" aria-label="打开文章目录" aria-expanded="false" aria-controls="archive-nav">
        <Icon name="menu" size={18} /><span class="sr-only">打开目录</span>
      </button>
    )}
  </div>
</header>
<nav class="brand-switcher-nav" aria-label="主导航" transition:persist="brand-switcher-nav">
  <div class="brand-switcher" data-brand-switcher>
    <a class:list={{ 'home-tab': true, active: !activeBrand }} href={sitePath()}>
      {!activeBrand && <div class="nav-highlight" transition:name="brand-highlight"></div>}
      <span style="position: relative; z-index: 10;" data-text="首页">首页</span>
    </a>
    <div class:list={{ 'brand-menu': true, active: colorOSActive }}>
      <a class="brand-tab brand-trigger" href={colorOSLatestUrl} aria-haspopup="menu" aria-expanded="false">
        {colorOSActive && <div class="nav-highlight" transition:name="brand-highlight"></div>}
        <span style="position: relative; z-index: 10;" data-text={brandMeta.coloros.name}>{brandMeta.coloros.name}</span><i aria-hidden="true"></i>
      </a>
      <div class="brand-submenu" role="menu" aria-label="ColorOS 档案">
        <a class:list={{ active: activeColorOSSection === '15' }} role="menuitem" href={officialArchiveMeta['15'].route} data-astro-reload>ColorOS 15</a>
        <a class:list={{ active: activeColorOSSection === '16' }} role="menuitem" href={officialArchiveMeta['16'].route} data-astro-reload>ColorOS 16</a>
        <a class:list={{ active: activeColorOSSection !== '15' && activeColorOSSection !== '16' }} role="menuitem" href={colorOSLatestUrl}>月更记录</a>
      </div>
    </div>
    <div class:list={{ 'brand-menu': true, active: originOSActive }}>
      <a class="brand-tab brand-trigger" href={originOSLatestUrl} aria-haspopup="menu" aria-expanded="false">
        {originOSActive && <div class="nav-highlight" transition:name="brand-highlight"></div>}
        <span style="position: relative; z-index: 10;" data-text={brandMeta.originos.name}>{brandMeta.originos.name}</span><i aria-hidden="true"></i>
      </a>
      <div class="brand-submenu" role="menu" aria-label="OriginOS 档案">
        <a class:list={{ active: activeOriginOSSection === 'originos6' }} role="menuitem" href={officialArchiveMeta['originos6'].route} data-astro-reload>OriginOS 6</a>
        <a class:list={{ active: activeOriginOSSection !== 'originos6' }} role="menuitem" href={originOSLatestUrl}>月更记录</a>
      </div>
    </div>
    <div class:list={{ 'brand-menu': true, active: hyperOSActive }}>
      <a class="brand-tab brand-trigger" href={hyperOSLatestUrl} aria-haspopup="menu" aria-expanded="false">
        {hyperOSActive && <div class="nav-highlight" transition:name="brand-highlight"></div>}
        <span style="position: relative; z-index: 10;" data-text={brandMeta.hyperos.name}>{brandMeta.hyperos.name}</span><i aria-hidden="true"></i>
      </a>
      <div class="brand-submenu" role="menu" aria-label="HyperOS 档案">
        <a class:list={{ active: activeHyperOSSection === '4' }} role="menuitem" href={officialArchiveMeta['hyperos4'].route} data-astro-reload>HyperOS 4</a>
        <a class:list={{ active: activeHyperOSSection === '3' }} role="menuitem" href={officialArchiveMeta['hyperos3'].route} data-astro-reload>HyperOS 3</a>
        <a class:list={{ active: activeHyperOSSection === '2' }} role="menuitem" href={officialArchiveMeta['hyperos2'].route} data-astro-reload>HyperOS 2</a>
        <a class:list={{ active: activeHyperOSSection === '1' }} role="menuitem" href={officialArchiveMeta['hyperos1'].route} data-astro-reload>HyperOS 1</a>
        <a class:list={{ active: activeHyperOSSection !== '1' && activeHyperOSSection !== '2' && activeHyperOSSection !== '3' && activeHyperOSSection !== '4' }} role="menuitem" href={hyperOSLatestUrl}>月更记录</a>
      </div>
    </div>
    <a class:list={{ 'brand-tab': true, active: magicOSActive }} href={magicOSLatestUrl}>
      {magicOSActive && <div class="nav-highlight" transition:name="brand-highlight"></div>}
      <span style="position: relative; z-index: 10;" data-text={brandMeta.magicos.name}>{brandMeta.magicos.name}</span>
    </a>
  </div>
</nav>
