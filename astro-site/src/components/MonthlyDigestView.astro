---
import { assetPath, type ArchiveArticle } from '../lib/archive';
import type { MonthlyDigest } from '../lib/monthly-digests';

interface Props {
  digest: MonthlyDigest;
  article?: ArchiveArticle;
}
const { digest, article } = Astro.props;
const data = digest.data;
const typeClass = (type: string) => `digest-type digest-type-${type === '未标注' ? 'unknown' : type}`;

const highlightGroups: { key: string, items: typeof data.highlights }[] = [];
for (const item of data.highlights) {
  const key = `${item.module}|${item.title}`;
  if (highlightGroups.length > 0 && highlightGroups[highlightGroups.length - 1].key === key) {
    highlightGroups[highlightGroups.length - 1].items.push(item);
  } else {
    highlightGroups.push({ key, items: [item] });
  }
}
const isColorOS17 = article?.data.slug === '63-coloros-17' || data.articleId === 'ColorOS_17_正式发布！亮点抢先看';
const isColorOS16 = article?.data.slug === '08-coloros-16' || data.articleId === 'ColorOS_16_正式发布！亮点抢先看';
const isOriginOS7 = article?.data.slug === '64-originos-7' || data.articleId === '带你一图读懂_OriginOS_7' || article?.data.slug === '69-originos-7-highlights' || data.articleId === '更多_OriginOS_7_体验亮点';
const isOriginOS6 = article?.data.slug === '65-originos-6' || data.articleId === 'OriginOS_6_正式发布！亮点抢先看';
const isHyperOS4 = data.articleId === 'HyperOS_4_更新说明_(2026)' || article?.data.slug === '44-xiaomi-hyperos-4';
const isHyperOS3 = data.articleId === 'HyperOS_3_更新说明_(2025)' || article?.data.slug === '66-xiaomi-hyperos-3';
const isMagicOS11 = article?.data.slug === '62-honor-magicos-11' || data.articleId === 'MagicOS_11正式发布！一图读懂升级亮点_(2026)';
const isMagicOS10 = article?.data.slug === '67-honor-magicos-10' || data.articleId === 'MagicOS_10正式发布！一图读懂升级亮点_(2025)';
const isHarmonyOS6 = article?.data.slug === '68-huawei-harmonyos-6' || data.articleId === 'HarmonyOS_6_正式发布！亮点抢先看';
const isMajorRelease = isColorOS17 || isColorOS16 || isOriginOS7 || isOriginOS6 || isHyperOS4 || isHyperOS3 || isMagicOS11 || isMagicOS10 || isHarmonyOS6;

const monthMap: Record<string, string> = {
  '1': '一月', '01': '一月', '一': '一月',
  '2': '二月', '02': '二月', '二': '二月',
  '3': '三月', '03': '三月', '三': '三月',
  '4': '四月', '04': '四月', '四': '四月',
  '5': '五月', '05': '五月', '五': '五月',
  '6': '六月', '06': '六月', '六': '六月',
  '7': '七月', '07': '七月', '七': '七月',
  '8': '八月', '08': '八月', '八': '八月',
  '9': '九月', '09': '九月', '九': '九月',
  '10': '十月', '十': '十月',
  '11': '十一月', '十一': '十一月',
  '12': '十二月', '十二': '十二月'
};

const extractMonthName = (id: string, title?: string, publishedAt?: string): string => {
  const mTitle = (title || '').match(/([0-9]{1,2}|[一二三四五六七八九十]+)月/);
  if (mTitle && monthMap[mTitle[1]]) return monthMap[mTitle[1]];

  const mId = id.match(/([0-9]{1,2}|[一二三四五六七八九十]+)月/);
  if (mId && monthMap[mId[1]]) return monthMap[mId[1]];

  if (publishedAt) {
    const mDate = publishedAt.match(/202[0-9]-(\d{2})/);
    if (mDate && monthMap[mDate[1]]) return monthMap[mDate[1]];
  }

  const mIdDate = id.match(/202[0-9][-_\.](\d{2})/);
  if (mIdDate && monthMap[mIdDate[1]]) return monthMap[mIdDate[1]];

  return '本月';
};

const generateMonthlySummary = (highlights: typeof data.highlights, updates: typeof data.updates): string => {
  const totalCount = highlights.length + updates.length;
  if (!highlights.length) {
    if (updates.length) {
      const topModules = [...new Set(updates.map(u => u.module))].slice(0, 3).join('、');
      return `聚焦${topModules}等 ${totalCount} 项系统基础体验优化。`;
    }
    return '聚焦系统功能变化与日常体验全面升级。';
  }

  const topTitles = highlights.slice(0, 3).map(h => h.title);
  if (topTitles.length === 1) {
    return `重点升级${topTitles[0]}，共带来 ${totalCount} 项功能升级与细节体验优化。`;
  }
  if (topTitles.length === 2) {
    return `重点升级${topTitles[0]}与${topTitles[1]}，共带来 ${totalCount} 项功能升级与细节体验优化。`;
  }

  const formattedTitles = `${topTitles.slice(0, -1).join('、')}及${topTitles[topTitles.length - 1]}`;
  return `重点升级${formattedTitles}，共带来 ${totalCount} 项功能升级与细节体验优化。`;
};

const monthName = extractMonthName(data.articleId, article?.data.title, article?.data.publishedAt);
const eyebrow = isColorOS17
  ? '软件版本 PKB110_17.0.0.100(CN01C10P02)'
  : isColorOS16
    ? '软件版本 PKB110_16.0.0.100(CN01C10P01)'
    : isOriginOS7
      ? '版本 OriginOS 7 Beta (PD2602C_A_17.0.14.5.W10.V000L1)'
      : isOriginOS6
        ? '版本 OriginOS 6 (PD2501C_A_16.0.10.8.W10.V000L1)'
        : isHyperOS4
          ? '软件版本 OS4.0.2.0.WACNXM'
          : isHyperOS3
            ? '软件版本 OS3.0.1.0.VNACNXM'
            : isMagicOS11
              ? '软件版本 11.0.0.120(C00E120R4P1)'
              : isMagicOS10
                ? '软件版本 10.0.0.118(C00E118R3P1)'
                : isHarmonyOS6
                  ? '软件版本 6.0.0.108(SP1C00E108R1P1)'
                  : '文字精校版';

const heading = isColorOS17
  ? 'ColorOS 17 更新说明'
  : isColorOS16
    ? 'ColorOS 16 更新说明'
    : isOriginOS7
      ? 'OriginOS 7 更新说明'
      : isOriginOS6
        ? 'OriginOS 6 更新说明'
        : isHyperOS4
          ? '小米澎湃OS 4 更新说明'
          : isHyperOS3
            ? '小米澎湃OS 3 更新说明'
            : isMagicOS11
              ? 'MagicOS 11 更新说明'
              : isMagicOS10
                ? 'MagicOS 10 更新说明'
                : isHarmonyOS6
                  ? 'HarmonyOS 6 更新说明'
                  : `${monthName}升级一览`;

const subtitle = isColorOS17
  ? '上手丝滑，久用流畅。全新流体设计，OPPO AI 更懂你。'
  : isColorOS16
    ? '全场景丝滑流畅，系统级人工智能全面进化。极光引擎与潮汐引擎深度协同，全新繁星编译器加持。'
    : isOriginOS7
      ? '流畅超舒适，小V超贴心。光影流转，自然连贯，蓝心大模型深度融入系统体验。'
      : isOriginOS6
        ? '流畅舒适，6的飞起。全新光影空间设计，蓝河流畅引擎与蓝海续航系统强力支撑。'
        : isHyperOS4
          ? '全面升级的一气呵成体验。'
          : isHyperOS3
            ? '以体验做「顺」为目标，微架构级优化深入编译底层，打造体感流畅到底的生态体验。'
            : isMagicOS11
              ? '新一代 YOYO 智能体，全面进化的 AI 与流畅体验。'
              : isMagicOS10
                ? 'UX 视觉通透焕新，Turbo X 性能引擎深度打磨，荣耀 AI 与 YOYO 协同升级。'
                : isHarmonyOS6
                  ? '更好看、更好玩、更好用、更智能、更安全、更丝滑。智慧光感与全场景互联全面进阶。'
                  : generateMonthlySummary(data.highlights, data.updates);
const highlightHeading = isMajorRelease ? '更新功能一览' : '更新亮点';
---
<section class="monthly-digest" data-monthly-digest aria-labelledby="digest-heading">
  <header class="digest-intro">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="digest-heading">{heading}</h2>
    <p>{subtitle}</p>
  </header>

  <section class="digest-section" aria-labelledby="highlight-heading">
    <div class="digest-section-heading">
      <div>{data.updates.length > 0 && <span>01</span>}<h3 id="highlight-heading">{highlightHeading}</h3></div>
      <p>{data.highlights.length} 项重点功能</p>
    </div>
    <div class="digest-table-scroll" tabindex="0" role="region" aria-label="更新亮点表格，可左右滑动" data-digest-scroll>
      <table class="digest-table digest-highlight-table">
        <colgroup><col /><col /><col /><col /></colgroup>
        <thead><tr><th scope="col">模块</th><th scope="col">更新点</th><th scope="col">详细更新说明</th><th scope="col">演示资源</th></tr></thead>
        <tbody>
          {highlightGroups.map((group) => (
            group.items.map((item, index) => (
              <tr>
                {index === 0 && (
                  <th scope="row" class="digest-module" rowspan={group.items.length}>
                    <div class="digest-module-inner">
                      <span>{item.module}</span>
                    </div>
                  </th>
                )}
                {index === 0 && <td class="digest-title" rowspan={group.items.length}>{item.title}</td>}
                <td>{item.description}</td>
                <td class="digest-media-cell">
                  {item.media.length ? (
                    <div class="digest-media-list">
                      {item.media.map((media, mIndex) => (
                        <button class="digest-media-button" type="button" data-digest-media data-media-index={mIndex} data-kind={media.kind} data-src={assetPath(media.src)} data-poster={media.poster ? assetPath(media.poster) : undefined} data-alt={media.alt} aria-label={`查看${item.title}演示 ${mIndex + 1}/${item.media.length}`}>
                          <picture>
                            {media.avifThumbnail && <source srcset={assetPath(media.avifThumbnail)} type="image/avif" />}
                            <img src={assetPath(media.thumbnail)} alt="" width={media.width} height={media.height} loading="lazy" decoding="async" />
                          </picture>
                          {media.kind === 'video' && <span aria-hidden="true">▶</span>}
                          {media.kind === 'animated-image' && <span aria-hidden="true">GIF</span>}
                        </button>
                      ))}
                    </div>
                  ) : <span class="digest-media-empty">/</span>}
                </td>
              </tr>
            ))
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {data.updates.length > 0 && (
    <section class="digest-section" aria-labelledby="updates-heading">
      <div class="digest-section-heading">
        <div><span>02</span><h3 id="updates-heading">其他更新点</h3></div>
        <p>{data.updates.length} 项体验变化</p>
      </div>
      <div class="digest-table-scroll" tabindex="0" role="region" aria-label="其他更新点表格，可左右滑动" data-digest-scroll>
        <table class="digest-table digest-update-table">
          <colgroup><col /><col /><col /></colgroup>
          <thead><tr><th scope="col">模块</th><th scope="col">更新类型</th><th scope="col">更新说明</th></tr></thead>
          <tbody>
            {data.updates.map((item) => (
              <tr>
                <th scope="row" class="digest-module">{item.module}</th>
                <td class="digest-type-cell"><span class={typeClass(item.type)}>{item.type}</span></td>
                <td>{item.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
</section>

<dialog class="digest-lightbox" data-digest-lightbox aria-label="功能演示预览">
  <div class="digest-lightbox-bar"><p data-lightbox-caption></p><button type="button" data-lightbox-close aria-label="关闭预览">×</button></div>
  <div class="digest-lightbox-stage" data-lightbox-stage></div>
  <div class="digest-lightbox-nav" data-lightbox-nav hidden>
    <button type="button" data-lightbox-prev aria-label="上一张演示">←</button>
    <span data-lightbox-count></span>
    <button type="button" data-lightbox-next aria-label="下一张演示">→</button>
  </div>
</dialog>
