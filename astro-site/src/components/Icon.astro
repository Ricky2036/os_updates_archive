---
interface Props { name: 'search' | 'close' | 'arrow' | 'menu' | 'list' | 'image' | 'sidebar' | 'book' | 'layers' | 'grid' | 'timeline'; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></>}
  {name === 'close' && <><path d="M6 6 18 18" /><path d="M18 6 6 18" /></>}
  {name === 'arrow' && <><path d="M5 12h14" /><path d="m14 7 5 5-5 5" /></>}
  {name === 'menu' && <><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></>}
  {name === 'list' && <><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></>}
  {name === 'image' && <><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></>}
  {name === 'sidebar' && <><rect width="18" height="18" x="3" y="3" rx="3" /><line x1="9" y1="3" x2="9" y2="21" /></>}
  {name === 'book' && <><path d="M2 4.5h6a4 4 0 0 1 4 4v11a3 3 0 0 0-3-3H2z"/><path d="M22 4.5h-6a4 4 0 0 0-4 4v11a3 3 0 0 1 3-3h7z"/></>}
  {name === 'layers' && <><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></>}
  {name === 'grid' && <><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></>}
  {name === 'timeline' && <><circle cx="5" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><line x1="5" y1="8" x2="5" y2="16"/><line x1="11" y1="6" x2="20" y2="6"/><line x1="11" y1="18" x2="20" y2="18"/><line x1="11" y1="12" x2="16" y2="12"/></>}
</svg>
