---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchiveNav from '../../../components/ArchiveNav.astro';
import Icon from '../../../components/Icon.astro';
import MonthlyDigestView from '../../../components/MonthlyDigestView.astro';
import { brandMeta, getArticles, sitePath, articlePath, type ArchiveArticle, type Brand } from '../../../lib/archive';
import { getMonthlyDigest } from '../../../lib/monthly-digests';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => {
    const brandArticles = articles.filter((a) => a.data.brand === article.data.brand);
    const index = brandArticles.findIndex((a) => a.data.articleId === article.data.articleId);
    const prevArticle = index > 0 ? brandArticles[index - 1] : null;
    const nextArticle = index >= 0 && index < brandArticles.length - 1 ? brandArticles[index + 1] : null;
    return {
      params: { brand: article.data.brand, year: String(article.data.year), slug: article.data.slug },
      props: { article, prevArticle, nextArticle },
    };
  });
}

const { article, prevArticle, nextArticle } = Astro.props as {
  article: ArchiveArticle;
  prevArticle?: ArchiveArticle | null;
  nextArticle?: ArchiveArticle | null;
};
const data = article.data;
const meta = brandMeta[data.brand as Brand];
const mediaBase = import.meta.env.PUBLIC_MEDIA_BASE_URL?.replace(/\/$/, '');
const readyVideos = data.media.filter((item) => item.kind === 'video' && item.status === 'ready' && item.src);
const mediaUrl = (value: string) => `${mediaBase}/${value.split('/').map((part) => encodeURIComponent(part)).join('/')}`;
const image = data.cover?.src;
const digestEntry = await getMonthlyDigest(data.articleId);
const digest = digestEntry?.data.reviewStatus === 'verified' ? digestEntry : undefined;
---
<BaseLayout title={data.title} description={`${data.title}，${meta.name} 系统升级档案。`} brand={data.brand} image={image} articleMeta={{ publishedAt: data.publishedAt, brand: data.brand }} hasArchiveNav hasMonthlyViewToggle={!!digest}>
  <main class="article-layout">
    <ArchiveNav brand={data.brand} selectedId={data.articleId} />
    <article class="article-content">
      {digest ? (
        <div class="monthly-view" data-monthly-view-root>
          <section class="monthly-panel monthly-digest-panel" data-monthly-panel="digest">
            <MonthlyDigestView digest={digest} article={article} />
          </section>
          <section class="monthly-panel monthly-original-panel" data-monthly-panel="original">
            <div data-original-mount></div>
            <template data-original-template>
              {data.kind === 'gallery' ? (
                <div class="gallery-shell" data-gallery-shell>
                  <div class="media-loading" role="status"><span class="loading-spinner"></span><span>原始档案加载中…</span></div>
                  <div class="gallery-content" set:html={data.html} />
                </div>
              ) : (
                <section class="interactive-archive">
                  <div class="compat-frame-shell" data-compat-shell>
                    <div class="frame-loading" role="status"><span class="loading-spinner"></span><span>原始档案加载中…</span></div>
                    <iframe title={`${data.title} 交互内容`} data-src={sitePath(data.compatPath)} loading="lazy" sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer" data-compat-frame data-compat-id={data.slug}></iframe>
                  </div>
                </section>
              )}
            </template>
          </section>
        </div>
      ) : data.kind === 'gallery' ? (
          <div class="gallery-shell" data-gallery-shell>
            <div class="media-loading" role="status"><span class="loading-spinner"></span><span>内容加载中…</span></div>
            <div class="gallery-content" set:html={data.html} />
          </div>
        ) : (
          <section class="interactive-archive">
            <div class="compat-frame-shell" data-compat-shell>
              <div class="frame-loading" role="status"><span class="loading-spinner"></span><span>内容加载中…</span></div>
              <iframe title={`${data.title} 交互内容`} src={sitePath(data.compatPath)} loading="eager" sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer" data-compat-frame data-compat-id={data.slug}></iframe>
            </div>
          </section>
        )}

      {data.experience && mediaBase && (
        <section class="experience-panel reveal">
          <p class="eyebrow">功能演示</p>
          <h2>ColorOS 16 视频档案</h2>
          <div class="experience-actions">
            <a class="button button-primary" href={`${mediaBase}/${data.experience.entryPath}`} target="_blank" rel="noopener">浏览视频 <Icon name="arrow" /></a>
          </div>
          {readyVideos.length > 0 && (
            <details class="video-archive">
              <summary>浏览已归档视频（{readyVideos.length}）</summary>
              <div class="video-grid">
                {readyVideos.map((video) => (
                  <figure><video controls playsinline preload="none"><source src={mediaUrl(video.src!)} type="video/mp4" />您的浏览器暂不支持该视频。</video><figcaption>{decodeURIComponent(video.src!.split('/').at(-1) ?? '体验视频')}</figcaption></figure>
                ))}
              </div>
            </details>
          )}
        </section>
      )}
      <nav class="article-footer-nav" data-article-footer-nav data-next-url={nextArticle ? articlePath(nextArticle) : ''} data-prev-url={prevArticle ? articlePath(prevArticle) : ''}>
        <div class="footer-pull-wrapper" data-footer-pull-wrapper>
          <div class="article-footer-links" data-footer-links>
            {prevArticle ? (
              <a href={articlePath(prevArticle)} class="footer-nav-link" data-nav-prev data-astro-prefetch="hover">上一篇</a>
            ) : (
              <span class="footer-nav-link is-disabled">上一篇</span>
            )}
            <span class="footer-nav-divider" aria-hidden="true">｜</span>
            <button type="button" class="footer-nav-link footer-nav-top" data-scroll-top>回顶部</button>
            <span class="footer-nav-divider" aria-hidden="true">｜</span>
            {nextArticle ? (
              <a href={articlePath(nextArticle)} class="footer-nav-link" data-nav-next data-astro-prefetch="hover">下一篇</a>
            ) : (
              <span class="footer-nav-link is-disabled">下一篇</span>
            )}
          </div>
          <div class="footer-pull-hint" data-footer-pull-hint aria-hidden="true">
            <span class="pull-hint-icon">↑</span>
            <span class="pull-hint-text" data-pull-hint-text>{nextArticle ? '松手查看下一篇' : '已是最后一篇'}</span>
          </div>
        </div>
      </nav>
    </article>
  </main>
</BaseLayout>
